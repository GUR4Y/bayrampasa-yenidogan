# Database configuration (Defaults to SQLite for instant local run, easily switches to PostgreSQL for production)
# SQLite: file:./dev.db
# PostgreSQL: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL="file:./dev.db"

# Admin session authentication secret
ADMIN_SECRET="change-this-to-a-secure-random-key-in-production"

# Canonical URL for SEO & Open Graph
NEXT_PUBLIC_SITE_URL="https://bayrampasa-yenidogan.org.tr"

# TFF U17 Automatic Synchronization
# Set to 'true' only after verifying official data usage permissions
TFF_SYNC_ENABLED="false"
# Shared secret for cron / webhook synchronization (at least 32 characters)
TFF_SYNC_SECRET="change-this-to-a-random-32-char-secret-in-production"
